# Ignore generated training and testing CSV datasets
data/dataLatih/*.csv
data/dataUji/*.csv

# Ignore Jupyter Notebook checkpoints
.ipynb_checkpoints/
*/.ipynb_checkpoints/

# Ignore Python cache & test artifacts
__pycache__/
*.py[cod]
*$py.class
.pytest_cache/
.mypy_cache/

# Ignore runtime feedback log & general logs
data/feedback_log.json
logs/
*.log

# Ignore editor and local workspaces
.agents/
.claude/
.obsidian/
.vscode/
.idea/

# Ignore environment variables and secrets (semua direktori)
.env
.env.*
*.env
**/.env
**/.env.*
!.env.example
!**/.env.example

# Virtual environments
.venv/
venv/
env/
ENV/
.tmp_matplotlib/

# Runtime model artifacts
data/staging/
data/models/
data/active_model.json

# MS Office temporary lock files (muncul saat file Excel / Word sedang dibuka)
~$*.xlsx
~$*.xls
~$*.docx
~$*.doc

# Local reference docs & OS files
referensi/
.DS_Store
Thumbs.db
desktop.ini
